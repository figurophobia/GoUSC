# Configuración del despliegue (compose.prod.yaml).
# Copia este fichero como .env y cambia lo que necesites: cp .env.example .env
# El fichero .env no se sube a git.

# Puerto de la máquina por el que se accede a la web (http://IP:GOUSC_PORT)
GOUSC_PORT=8080

# Base de datos. Cambia la contraseña antes de desplegar en un servidor compartido.
# Ojo: si cambias estos valores con la base de datos ya creada, no se aplican
# (PostgreSQL solo los usa la primera vez). Ver docs/deploy.md.
POSTGRES_DB=gousc
POSTGRES_USER=gousc
POSTGRES_PASSWORD=gousc

# Opciones de la JVM
JAVA_OPTS=-XX:MaxRAMPercentage=75
